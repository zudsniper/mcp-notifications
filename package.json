{
  "name": "mcp-notifications-monorepo",
  "private": true,
  "version": "3.0.0",
  "description": "MCP Notifications with SSE server, Next.js webapp, and PocketBase backend",
  "workspaces": [
    "apps/*",
    "packages/*",
    "legacy"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "build": "npm run build --workspaces",
    "start": "npm run start --workspaces",
    "lint": "npm run lint --workspaces",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules legacy/node_modules"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "@types/node": "^22.14.0"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zudsniper/mcp-server-notifier.git"
  },
  "keywords": [
    "mcp",
    "notifications",
    "sse",
    "nextjs",
    "pocketbase",
    "cloudflare",
    "webhook"
  ],
  "authors": [
    {
      "name": "tuberrabbit",
      "email": "tuberrabbit@gmail.com"
    },
    {
      "name": "Jason McElhenny",
      "email": "me@zod.tf",
      "url": "https://github.com/zudsniper"
    }
  ],
  "license": "MIT"
}